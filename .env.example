# Copie para .env (na raiz do repositório) e preencha. Nunca versione o .env.

# --- LLM (MariTalk, API compatível com OpenAI, usada pelo Agno) ---
MARITALK_API_KEY=
MARITALK_API_BASE=https://chat.maritaca.ai/api
MARITALK_MODEL=sabiazinho-4

# --- Modelos locais (Hugging Face) ---
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual   # opcional (1,1 GB); vazio = sem reranker

# --- Acervo processual ---
# Só marque true quando houver declaração do responsável de que os PDFs podem ser usados; registre a base.
CORPUS_AUTHORIZED=false
CORPUS_AUTHORIZATION_BASIS=nao_declarada

# --- Chatwoot ---
CHATWOOT_BASE_URL=https://chatwoot.srv1633081.hstgr.cloud
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=          # token do usuário administrador (setup de equipes e etiquetas)
CHATWOOT_BOT_TOKEN=          # token do Agent Bot (resposta e transferência)
CHATWOOT_WEBHOOK_SECRET=     # segredo da URL do webhook (?token=...)
HANDOFF_MAX_ATTEMPTS=3

# --- API ---
ADMIN_API_TOKEN=             # protege /api/admin/*
